<Window x:Class="StudyDesk.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AkshatOS · Study Desk" Width="720" Height="650" MinWidth="480" MinHeight="440"
 Background="#191B1A" Foreground="#F3F0EA" FontFamily="Segoe UI" FontSize="16"
 ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Copper" Color="#E5AD86"/>
  <SolidColorBrush x:Key="Muted" Color="#BEC4B9"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="16,8"/>
   <Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Background" Value="#30372F"/>
   <Setter Property="Foreground" Value="#F3F0EA"/><Setter Property="BorderBrush" Value="#66715F"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#E5AD86"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#E5AD86"/><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Edge" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F3F0EA"/><Setter Property="Margin" Value="0,8,18,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#F3F0EA"/><Setter Property="Margin" Value="0,14,0,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#242822"/><Setter Property="Foreground" Value="#F3F0EA"/><Setter Property="CaretBrush" Value="#E5AD86"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#66715F"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,22,28,24">
   <DockPanel LastChildFill="True">
    <CheckBox x:Name="Pin" DockPanel.Dock="Right" Content="Stay on top" Checked="PreferenceChanged" Unchecked="PreferenceChanged" AutomationProperties.Name="Keep Study Desk above other windows"/>
    <TextBlock Text="Study Desk" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock x:Name="DayLabel" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
   <Border Background="#242822" CornerRadius="16" Padding="24" Margin="0,24,0,0">
    <StackPanel>
     <TextBlock x:Name="RunState" Text="Ready when you are" Foreground="{StaticResource Copper}" FontSize="18"/>
     <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,12,0,0">
      <TextBlock x:Name="Remaining" Text="6:00:00" FontSize="92" FontWeight="Medium" TextWrapping="NoWrap"
       Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Time remaining"/>
     </Viewbox>
     <TextBlock x:Name="RemainingLabel" Text="Remaining today" Foreground="{StaticResource Muted}"/>
     <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Margin="0,24,0,16" Foreground="{StaticResource Copper}" Background="#46503F" BorderThickness="0" AutomationProperties.Name="Today's study progress"/>
     <TextBlock x:Name="Studied" FontSize="23" Typography.NumeralAlignment="Tabular"/>
     <TextBlock x:Name="TopicLabel" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
     <Button x:Name="TimerAction" Content="Start studying" Click="ToggleTimer" Background="{StaticResource Copper}" Foreground="#191B1A" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,24,0,0" MinWidth="190"/>
    </StackPanel>
   </Border>
   <TextBlock x:Name="Notice" Foreground="{StaticResource Muted}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
   <Expander x:Name="Customize" Header="Customize">
    <StackPanel Margin="0,14,0,0">
     <TextBlock Text="Timer text size"/><Slider x:Name="TimerScale" Minimum="40" Maximum="180" Value="92" TickFrequency="8" ValueChanged="ScaleChanged" Margin="0,10,0,18" AutomationProperties.Name="Timer text size"/>
     <TextBlock Text="Daily aim in hours · future study days"/><TextBox x:Name="TargetInput" Text="6" MaxLength="5" Margin="0,8,0,16" AutomationProperties.Name="Daily study aim in hours"/>
     <TextBlock Text="Topic for the next block (optional)"/><TextBox x:Name="TopicInput" MaxLength="200" Margin="0,8,0,12" AutomationProperties.Name="Topic for the next study block"/>
     <Button Content="Save preferences" Click="SavePreferences" HorizontalAlignment="Left"/>
     <TextBlock Text="Drag or resize the window normally. Large text fits the available width; all controls remain available by scrolling. Closing, minimizing, locking or sleep pauses. Resume is always manual." Foreground="{StaticResource Muted}"/>
    </StackPanel>
   </Expander>
   <Expander x:Name="Transfer" Header="Phone transfer">
    <StackPanel Margin="0,14,0,0">
     <TextBlock Text="Use one timer at a time. Finished sessions can be combined; overlaps and changed records stop the import." Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
     <WrapPanel>
      <Button Content="Export sessions…" Click="ExportManual"/>
      <Button Content="Import phone sessions…" Click="ImportManual"/>
      <Button Content="Choose iCloud / Files folder…" Click="ChooseFolder"/>
      <Button Content="Send to linked folder" Click="SendLinked"/>
      <Button Content="Check linked phone files" Click="ReadLinked"/>
      <Button Content="Unlink folder" Click="UnlinkFolder"/>
     </WrapPanel>
     <TextBlock x:Name="FolderLabel" Foreground="{StaticResource Muted}"/>
     <TextBlock x:Name="PhoneAsOf" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
     <TextBlock Text="Local records stay on this PC. Choosing a cloud folder shares exported records through that provider. A folder write does not confirm arrival on your phone. No automatic cloud writes." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
    </StackPanel>
   </Expander>
   <Expander x:Name="History" Header="Recorded sessions">
    <StackPanel Margin="0,14,0,0">
     <TextBlock Text="Completed records are read-only in this first exchange version. Missing records in a file never delete saved history. Changed records require reconciliation; they are not silently overwritten." Foreground="{StaticResource Muted}"/>
     <ItemsControl x:Name="Sessions" Margin="0,12,0,0">
      <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,12"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Expander>
  </StackPanel>
 </ScrollViewer>
</Window>
